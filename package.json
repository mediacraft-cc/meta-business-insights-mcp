{
  "name": "meta-business-insights-mcp",
  "version": "0.4.0",
  "private": true,
  "description": "MCP server para dados orgânicos + pagos do Meta Business (Facebook Pages e Instagram) via Graph API, com agregação cross-account do portfólio.",
  "type": "module",
  "bin": {
    "meta-business-insights-mcp": "dist/bin/stdio.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "dev": "tsc --watch",
    "start": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "probe": "node dist/bin/probe.js",
    "snapshot": "node dist/bin/snapshot.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
